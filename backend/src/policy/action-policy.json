    {
      "id": "service-status",
      "description": "Reports the state of a named approved service on the endpoint.",
      "category": "service_status",
      "guidedStepRef": "service_status:0",
      "tier": "read_only",
      "command": "sudo /usr/local/bin/service-status.sh {{service}}",
