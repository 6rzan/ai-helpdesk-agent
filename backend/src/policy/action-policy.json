    {
      "id": "peripheral-list",
      "description": "Lists devices visible to the endpoint. This is the container's own device view, not the employee's physical desk.",
      "category": "peripherals",
      "guidedStepRef": "peripherals:0",
      "tier": "read_only",
      "command": "/usr/local/bin/peripheral-list.sh",
      "arguments": [],
