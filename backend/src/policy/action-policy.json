      "category": "printer",
      "guidedStepRef": "printer:1",
      "tier": "state_changing",
      "command": "/usr/local/bin/clear-print-queue.sh",
      "arguments": [],
      "allowedEndpointIds": ["test-node-b"],
      "verifiedBy": "print-queue-status",
      "timeoutMs": null
