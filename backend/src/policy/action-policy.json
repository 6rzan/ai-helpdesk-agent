{
  "version": "1.0.0",
  "entries": [
    {
      "id": "account-status",
      "description": "Checks whether a local test account on the endpoint is locked, and whether its password is flagged for a forced change at next sign-in.",
      "category": "password_login",
      "guidedStepRef": "password_login:2",
      "tier": "read_only",
      "command": "sudo /usr/local/bin/account-status.sh {{username}}",
      "arguments": [
        { "name": "username", "kind": "enum", "values": ["test-user-locked", "test-user-active"] }
      ],
      "allowedEndpointIds": ["test-node-a"],
      "verifiedBy": null,
      "timeoutMs": null
    },
    {
      "id": "unlock-account",
      "description": "Unlocks a locked local test account on the endpoint.",
      "category": "password_login",
      "guidedStepRef": "password_login:2",
      "tier": "state_changing",
      "command": "sudo /usr/local/bin/unlock-account.sh {{username}}",
      "arguments": [
        { "name": "username", "kind": "enum", "values": ["test-user-locked", "test-user-active"] }
      ],
      "allowedEndpointIds": ["test-node-a"],
      "verifiedBy": "account-status",
      "timeoutMs": null
    },
    {
      "id": "expire-password",
      "description": "Forces a password change at next sign-in for a local test account on the endpoint.",
      "category": "password_login",
      "guidedStepRef": "password_login:2",
      "tier": "state_changing",
      "command": "sudo /usr/local/bin/expire-password.sh {{username}}",
      "arguments": [
        { "name": "username", "kind": "enum", "values": ["test-user-locked", "test-user-active"] }
      ],
      "allowedEndpointIds": ["test-node-a"],
      "verifiedBy": "account-status",
      "timeoutMs": null
    },
    {
      "id": "network-probe",
      "description": "Checks reachability and DNS resolution for a named target, as seen from the endpoint.",
      "category": "network",
      "guidedStepRef": "network:1",
      "tier": "read_only",
      "command": "/usr/local/bin/network-probe.sh {{target}}",
      "arguments": [
        { "name": "target", "kind": "enum", "values": ["test-node-a", "test-node-b", "1.1.1.1"] }
      ],
      "allowedEndpointIds": ["test-node-a", "test-node-b"],
      "verifiedBy": null,
      "timeoutMs": null
    },
    {
      "id": "print-queue-status",
      "description": "Lists jobs currently queued on the endpoint's print service.",
